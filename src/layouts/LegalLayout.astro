---
import Layout from '~/layouts/Layout.astro';
import { site } from '~/config/site';

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;

const pages = [
  { href: '/about', label: 'About' },
  { href: '/privacy', label: 'Privacy Policy' },
  { href: '/terms', label: 'Terms & Conditions' },
  { href: '/contact', label: 'Contact' },
];
---

<Layout title={title} description={description}>
  <div class="page">
    <div class="ambient" aria-hidden="true"></div>

    <header class="topbar">
      <a href="/" class="brand">
        <span class="brand-mark" aria-hidden="true">ख़</span>
        <span class="brand-name">{site.name}</span>
      </a>
      <a href="/" class="back">← Back to the parlour</a>
    </header>

    <main class="content">
      <article class="prose">
        <slot />
      </article>
    </main>

    <footer class="page-footer">
      <nav aria-label="More pages">
        {pages.map((p, i) => (
          <>
            {i > 0 && <span class="sep" aria-hidden="true">·</span>}
            <a href={p.href}>{p.label}</a>
          </>
        ))}
      </nav>
      <p class="copyright">© 2026 {site.name} · {site.domain}</p>
    </footer>
  </div>
</Layout>

<style>
  .page {
    position: relative;
    min-height: 100svh;
    min-height: 100vh;
    background: radial-gradient(ellipse 80% 55% at 50% 0%, var(--maroon-deep) 0%, var(--bg) 62%);
    isolation: isolate;
  }

  .ambient {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(circle at 22% 8%, rgba(217, 168, 96, 0.14) 0%, rgba(217, 168, 96, 0) 45%),
      radial-gradient(circle at 82% 4%, rgba(217, 168, 96, 0.1) 0%, rgba(217, 168, 96, 0) 40%);
  }

  .topbar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: linear-gradient(135deg, #6a1f22 0%, #b9532c 55%, #d9a860 100%);
    color: var(--cream);
    font-family: var(--font-serif);
    font-size: 0.95rem;
    flex-shrink: 0;
  }
  .brand-name {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    color: var(--cream);
  }

  .back {
    font-size: 0.85rem;
    color: var(--cream-dim);
    padding: 0.4rem 0.75rem;
    border: 1px solid rgba(217, 168, 96, 0.22);
    border-radius: 999px;
    transition: border-color 180ms ease, color 180ms ease, background 180ms ease;
  }
  .back:hover {
    color: var(--cream);
    border-color: rgba(217, 168, 96, 0.5);
    background: rgba(217, 168, 96, 0.08);
  }

  .content {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    padding: 1rem 1.4rem 2rem;
  }

  .prose {
    width: 100%;
    max-width: 42rem;
    background: linear-gradient(180deg, rgba(58, 15, 17, 0.42) 0%, rgba(34, 9, 10, 0.5) 100%);
    border: 1px solid rgba(217, 168, 96, 0.18);
    border-radius: 16px;
    padding: 2rem 2.2rem 2.4rem;
    box-shadow: var(--shadow);
  }

  .page-footer {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 1.6rem 1.4rem 2.2rem;
    text-align: center;
  }
  .page-footer nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
  }
  .page-footer nav a {
    color: var(--cream-dim);
    transition: color 180ms ease;
  }
  .page-footer nav a:hover {
    color: var(--gold);
  }
  .page-footer .sep {
    color: rgba(246, 234, 211, 0.3);
  }
  .copyright {
    margin: 0;
    font-size: 0.75rem;
    color: var(--cream-soft);
  }

  @media (max-width: 640px) {
    .topbar { padding: 0.9rem 1rem; }
    .brand-name { font-size: 0.95rem; }
    .back { font-size: 0.78rem; padding: 0.35rem 0.65rem; }
    .content { padding: 0.5rem 0.9rem 1.5rem; }
    .prose { padding: 1.5rem 1.3rem 1.8rem; border-radius: 14px; }
  }

  /* Prose typography for slotted content (headings, paragraphs, lists,
     tables authored directly in each page) -- :global() is required since
     slotted markup isn't part of this component's own template. */
  .prose :global(h1) {
    font-family: var(--font-serif);
    font-size: 2rem;
    line-height: 1.15;
    color: var(--cream);
    margin: 0 0 0.4rem;
  }
  .prose :global(.updated) {
    font-size: 0.8rem;
    color: var(--cream-soft);
    margin: 0 0 1.8rem;
    letter-spacing: 0.02em;
  }
  .prose :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    color: var(--gold);
    margin: 2rem 0 0.7rem;
    padding-top: 1.2rem;
    border-top: 1px solid rgba(217, 168, 96, 0.16);
  }
  .prose :global(h2:first-of-type) {
    margin-top: 1.4rem;
    padding-top: 0;
    border-top: none;
  }
  .prose :global(h3) {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--cream);
    margin: 1.2rem 0 0.5rem;
  }
  .prose :global(p) {
    color: var(--cream-dim);
    line-height: 1.65;
    font-size: 0.95rem;
    margin: 0 0 0.9rem;
  }
  .prose :global(ul),
  .prose :global(ol) {
    color: var(--cream-dim);
    line-height: 1.6;
    font-size: 0.95rem;
    margin: 0 0 0.9rem;
    padding-left: 1.3rem;
  }
  .prose :global(li) {
    margin-bottom: 0.35rem;
  }
  .prose :global(a) {
    color: var(--gold);
    text-decoration: underline;
    text-decoration-color: rgba(217, 168, 96, 0.4);
    text-underline-offset: 2px;
  }
  .prose :global(a:hover) {
    text-decoration-color: var(--gold);
  }
  .prose :global(strong) {
    color: var(--cream);
    font-weight: 600;
  }
  .prose :global(.table-wrap) {
    overflow-x: auto;
    margin: 0 0 1.2rem;
    border: 1px solid rgba(217, 168, 96, 0.18);
    border-radius: 10px;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid rgba(217, 168, 96, 0.14);
    color: var(--cream-dim);
    vertical-align: top;
  }
  .prose :global(th) {
    color: var(--gold);
    font-weight: 600;
    background: rgba(217, 168, 96, 0.06);
  }
  .prose :global(tr:last-child td) {
    border-bottom: none;
  }
  .prose :global(.mail-chip) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    margin: 0.3rem 0 1rem;
    background: linear-gradient(180deg, rgba(58, 15, 17, 0.5) 0%, rgba(42, 10, 12, 0.56) 100%);
    border: 1px solid rgba(217, 168, 96, 0.3);
    border-radius: 999px;
    color: var(--cream) !important;
    text-decoration: none !important;
    font-size: 0.92rem;
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }
  .prose :global(.mail-chip:hover) {
    border-color: rgba(217, 168, 96, 0.6);
    background: linear-gradient(180deg, rgba(74, 20, 22, 0.6) 0%, rgba(52, 14, 16, 0.62) 100%);
    transform: translateY(-1px);
  }
</style>
