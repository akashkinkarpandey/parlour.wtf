---
import Layout from '~/layouts/Layout.astro';
import hero from '~/assets/hero.webp';
import heroJpg from '~/assets/hero.jpg';
import heroMobile from '~/assets/hero-mobile.webp';
import heroMobileJpg from '~/assets/hero-mobile.jpg';
import albumArt from '~/assets/album-art.webp';
import { site } from '~/config/site';

// Everything on this page is computed client-side from a fixed epoch, so
// there's nothing per-request to render — prerender it to a static asset
// (served straight from Cloudflare's edge, no Worker invocation per view).
export const prerender = true;

// Serialize the small subset the client needs, so we ship no more than needed.
const clientConfig = {
  epochStart: site.epochStart,
  spotify: site.spotifyPlaylistUrl,
  ytmusic: site.ytMusicPlaylistUrl,
  tracks: site.tracks.map((t) => ({
    title: t.title,
    artist: t.artist,
    durationSec: t.durationSec,
    href: t.href ?? site.spotifyPlaylistUrl,
    youtubeId: t.youtubeId,
  })),
};
---
<Layout>
  <main class="stage">
    <picture class="bg">
      <source srcset={heroMobile.src} type="image/webp" media="(max-width: 760px)" />
      <source srcset={heroMobileJpg.src} type="image/jpeg" media="(max-width: 760px)" />
      <source srcset={hero.src} type="image/webp" />
      <img
        src={heroJpg.src}
        width={hero.width}
        height={hero.height}
        alt="A bustling ladies’ parlour: friends chatting over chai, a woman getting a head massage, hairstyling and manicures around arched bulb-lit mirrors, retro Bollywood posters on the walls, an open door to an Indian street. The counter reads Khoobsurati (खूबसूरती) — beauty, from within and from without."
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="bg-img"
      />
    </picture>

    <div class="scrim scrim-top" aria-hidden="true"></div>
    <div class="scrim scrim-bottom" aria-hidden="true"></div>
    <div class="vignette" aria-hidden="true"></div>
    <div class="ambient-glow" aria-hidden="true">
      <span class="glow glow-a"></span>
      <span class="glow glow-b"></span>
    </div>

    <h1 class="sr-only">
      Khoobsurati — 90s Bollywood that played at your neighborhood parlour
    </h1>

    <header class="topbar">
      <div class="counter chip" aria-live="polite" title="Someone's probably gossiping right now.">
        <span class="dot" aria-hidden="true"></span>
        <span class="count-text"><span id="online-count">1</span> online</span>
      </div>

      <nav class="links" aria-label="Playlists">
        <a
          href={site.spotifyPlaylistUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="playlist-link chip"
        >
          <span class="badge badge-spotify" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="12" height="12"><path fill="#fff" d="M17.9 16.5a.75.75 0 0 1-1 .3c-2.9-1.7-6.5-2-10.7-1a.75.75 0 1 1-.35-1.45c4.6-1.1 8.6-.75 11.9 1.15a.75.75 0 0 1 .15 1zM19.3 13.2a.94.94 0 0 1-1.3.3c-3.3-2-8.4-2.6-12.35-1.4a.94.94 0 1 1-.55-1.8c4.5-1.35 10.15-.7 13.95 1.65a.94.94 0 0 1 .25 1.25zM19.45 10c-4-2.35-10.6-2.55-14.4-1.4a1.12 1.12 0 1 1-.65-2.15c4.35-1.3 11.6-1.05 16.2 1.65a1.12 1.12 0 1 1-1.15 1.9z"/></svg>
          </span>
          <span>Spotify</span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
        <a
          href={site.ytMusicPlaylistUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="playlist-link chip"
        >
          <span class="badge badge-ytmusic" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="12" height="12"><path fill="#fff" d="M9.5 8.2v7.6l6.5-3.8-6.5-3.8z"/></svg>
          </span>
          <span>YT Music</span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
        <details class="more">
          <summary class="chip more-btn" aria-label="More pages">
            <span aria-hidden="true">⋯</span>
          </summary>
          <div class="more-menu" role="menu">
            <a href="/about" role="menuitem">About</a>
            <a href="/privacy" role="menuitem">Privacy Policy</a>
            <a href="/terms" role="menuitem">Terms &amp; Conditions</a>
            <a href="/contact" role="menuitem">Contact</a>
          </div>
        </details>
      </nav>
    </header>

<section class="player" id="player" aria-label="Now playing">
      <div class="row">
        <button type="button" class="art" id="btn-art" aria-label="Play in browser" title="Khubsurati + Confidence = Kamaal">
          <img src={albumArt.src} width="64" height="64" alt="" loading="lazy" decoding="async" />
        </button>
        <div class="meta">
          <div class="track-info" aria-live="polite" aria-atomic="true">
            <div class="track" id="track-title">Loading the parlour radio…</div>
            <div class="artist" id="track-artist">&nbsp;</div>
          </div>
          <div class="progress" id="progress" aria-hidden="true">
            <div class="bar"><div class="bar-fill" id="bar-fill"></div></div>
            <div class="times">
              <span id="time-elapsed">0:00</span>
              <span id="time-total">0:00</span>
            </div>
          </div>
        </div>
        <div class="controls" role="group" aria-label="Playback">
          <button type="button" class="ctl" id="btn-prev" aria-label="Previous track">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M6 6h2v12H6zM20 6v12L9 12z"/></svg>
          </button>
          <button type="button" class="ctl ctl-play" id="btn-play" aria-label="Play">
            <svg id="icon-play" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" class="icon"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
            <svg id="icon-pause" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" class="icon is-hidden"><path fill="currentColor" d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
          </button>
          <button type="button" class="ctl" id="btn-next" aria-label="Next track">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M16 6h2v12h-2zM4 6l11 6-11 6z"/></svg>
          </button>
        </div>
      </div>
      <div class="embed" id="embed-mount" aria-hidden="true"></div>
    </section>
  </main>

  <script type="application/json" id="site-cfg" set:html={JSON.stringify(clientConfig)} />

  <script src="/player.js" defer is:inline></script>
  <script src="/nav.js" defer is:inline></script>
</Layout>

<style>
  .stage {
    position: relative;
    width: 100vw;
    min-height: 100svh;
    min-height: 100vh;
    overflow: hidden;
    isolation: isolate;
  }

  .bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .bg-img,
  .bg :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% center;
    transform-origin: center;
    animation: breathe 50s ease-in-out infinite alternate;
    will-change: transform;
  }

  /* A barely-perceptible drift, not a Ken Burns pan -- the whole scene
     should feel like it's breathing, not moving. */
  @keyframes breathe {
    from { transform: scale(1); }
    to { transform: scale(1.014); }
  }

  @media (max-width: 760px) {
    .bg-img,
    .bg :global(img) {
      object-position: center center;
    }
  }

  .scrim {
    position: absolute;
    left: 0;
    right: 0;
    pointer-events: none;
    z-index: 1;
  }
  .scrim-top {
    top: 0;
    height: 18vh;
    background: linear-gradient(
      to bottom,
      rgba(20, 10, 8, 0.55) 0%,
      rgba(20, 10, 8, 0.28) 55%,
      rgba(20, 10, 8, 0) 100%
    );
  }
  .scrim-bottom {
    bottom: 0;
    height: 32vh;
    background: linear-gradient(
      to top,
      rgba(20, 10, 8, 0.7) 0%,
      rgba(20, 10, 8, 0.4) 55%,
      rgba(20, 10, 8, 0) 100%
    );
  }

  /* Gently recedes the far corners (posters, top shelves, street edge) so
     the eye settles on the foreground group first without losing any
     detail -- no blur, just a soft radial falloff. */
  .vignette {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
      ellipse 78% 68% at 46% 56%,
      rgba(15, 7, 6, 0) 45%,
      rgba(15, 7, 6, 0.22) 100%
    );
  }

  /* Two soft warm blooms near the mirror-light strips, breathing in and
     out out of phase so it reads as bulbs flickering rather than a
     mechanical pulse. Screen blend keeps it additive/light-only. */
  .ambient-glow {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    mix-blend-mode: screen;
  }
  .glow {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(217, 168, 96, 0.5) 0%, rgba(217, 168, 96, 0) 70%);
    opacity: 0.35;
  }
  .glow-a {
    top: 4%;
    left: 32%;
    width: 22%;
    height: 40%;
    animation: flicker-a 7.5s ease-in-out infinite;
  }
  .glow-b {
    top: 2%;
    left: 56%;
    width: 20%;
    height: 42%;
    animation: flicker-b 9s ease-in-out infinite;
    animation-delay: -3s;
  }
  @keyframes flicker-a {
    0%, 100% { opacity: 0.28; }
    50% { opacity: 0.5; }
  }
  @keyframes flicker-b {
    0%, 100% { opacity: 0.22; }
    50% { opacity: 0.42; }
  }

  .sr-only {
    position: absolute !important;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .topbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 4;
    padding: 1.1rem 1.4rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.75rem;
    background: transparent;
    border: 1px solid rgba(217, 168, 96, 0.32);
    border-radius: 999px;
    color: var(--cream);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.55), 0 1px 12px rgba(0, 0, 0, 0.35);
  }

  .counter {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    padding: 0.32rem 0.6rem;
    border-radius: 8px;
    background: linear-gradient(
      180deg,
      rgba(58, 15, 17, 0.4) 0%,
      rgba(35, 9, 10, 0.46) 100%
    );
    border-color: rgba(217, 168, 96, 0.16);
    backdrop-filter: blur(8px) saturate(110%);
    -webkit-backdrop-filter: blur(8px) saturate(110%);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.14);
  }
  .count-text { font-variant-numeric: tabular-nums; color: var(--cream-dim); }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 0 rgba(217, 168, 96, 0.5);
    animation: pulse 3.4s ease-out infinite;
  }

  @keyframes pulse {
    0%   { box-shadow: 0 0 0 0 rgba(217, 168, 96, 0.5); }
    70%  { box-shadow: 0 0 0 7px rgba(217, 168, 96, 0); }
    100% { box-shadow: 0 0 0 0 rgba(217, 168, 96, 0); }
  }

  .links {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .playlist-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.86rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }
  .playlist-link:hover {
    border-color: rgba(217, 168, 96, 0.6);
  }
  .arrow { font-size: 0.78rem; opacity: 0.75; }

  .more {
    position: relative;
  }
  .more > summary {
    list-style: none;
    cursor: pointer;
  }
  .more > summary::-webkit-details-marker {
    display: none;
  }
  .more-btn {
    width: 34px;
    height: 34px;
    padding: 0;
    justify-content: center;
    font-size: 1.05rem;
    line-height: 1;
    color: var(--cream-dim);
    transition: border-color 180ms ease, background 180ms ease, color 180ms ease;
  }
  .more-btn:hover {
    color: var(--cream);
  }
  .more[open] .more-btn {
    color: var(--cream);
    border-color: rgba(217, 168, 96, 0.6);
  }
  .more-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 180px;
    padding: 0.4rem;
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, rgba(58, 15, 17, 0.86) 0%, rgba(34, 9, 10, 0.9) 100%);
    border: 1px solid rgba(217, 168, 96, 0.25);
    border-radius: 12px;
    backdrop-filter: blur(14px) saturate(130%);
    -webkit-backdrop-filter: blur(14px) saturate(130%);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    z-index: 6;
  }
  .more-menu a {
    padding: 0.55rem 0.7rem;
    border-radius: 8px;
    font-size: 0.85rem;
    color: var(--cream-dim);
    transition: background 150ms ease, color 150ms ease;
  }
  .more-menu a:hover {
    background: rgba(217, 168, 96, 0.12);
    color: var(--cream);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12);
  }
  .badge-spotify { background: #1db954; }
  .badge-ytmusic { background: #ff0000; }

  .player {
    position: absolute;
    left: 50%;
    bottom: 1.4rem;
    transform: translateX(-50%);
    z-index: 5;
    width: min(430px, calc(100% - 2rem));
    padding: 0.55rem 0.7rem;
    background: linear-gradient(
      180deg,
      rgba(56, 15, 17, 0.5) 0%,
      rgba(34, 9, 10, 0.58) 100%
    );
    color: var(--cream);
    border: 1px solid rgba(217, 168, 96, 0.2);
    border-radius: 11px;
    backdrop-filter: blur(10px) saturate(115%);
    -webkit-backdrop-filter: blur(10px) saturate(115%);
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(217, 168, 96, 0.1);
  }
  /* A thin brass hairline along the top edge -- reads as the edge of a
     physical object sitting in the scene, not a UI card floating on it. */
  .player::before {
    content: '';
    position: absolute;
    top: 0;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(217, 168, 96, 0.45), transparent);
  }
  .player .row {
    display: grid;
    grid-template-columns: 50px 1fr auto;
    grid-template-areas: "art meta controls";
    align-items: center;
    gap: 0.65rem;
  }
  .art { grid-area: art; }
  .meta { grid-area: meta; }
  .controls { grid-area: controls; }
  /* The YouTube iframe is mounted for audio playback only — it must stay
   * out of view (not display:none, or some browsers pause it). */
  .embed {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
    opacity: 0;
    pointer-events: none;
  }

  .art {
    display: block;
    width: 50px;
    height: 50px;
    border-radius: 6px;
    overflow: hidden;
    position: relative;
    padding: 0;
    border: 1px solid rgba(217, 168, 96, 0.4);
    background: rgba(58, 15, 17, 0.55);
    cursor: pointer;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.32), 0 0 0 3px rgba(217, 168, 96, 0.1);
    transition: transform 200ms ease, box-shadow 200ms ease;
  }
  .art:hover { transform: scale(1.03); box-shadow: 0 6px 20px rgba(0, 0, 0, 0.45); }
  .art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .meta { min-width: 0; }
  /* Wrap instead of single-line-ellipsis-truncate -- a two-line clamp only
     kicks in for genuinely long titles, so most tracks show their full
     name instead of getting cut short with "...". */
  .track {
    font-family: var(--font-serif);
    font-size: 0.92rem;
    line-height: 1.2;
    letter-spacing: 0.01em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .artist {
    font-size: 0.7rem;
    line-height: 1.3;
    letter-spacing: 0.03em;
    color: rgba(217, 168, 96, 0.75);
    margin-top: 0.1rem;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .progress { margin-top: 0.32rem; }
  .bar {
    height: 2px;
    width: 100%;
    background: rgba(246, 234, 211, 0.14);
    border-radius: 999px;
    overflow: visible;
    position: relative;
  }
  .bar-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--terracotta), var(--gold));
    border-radius: 999px;
    transition: width 500ms linear;
    position: relative;
  }
  /* A tiny needle at the fill's leading edge -- a tape-counter dial
     rather than a generic streaming-app progress bar. */
  .bar-fill::after {
    content: '';
    position: absolute;
    right: -2px;
    top: 50%;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--cream);
    transform: translateY(-50%);
    box-shadow: 0 0 4px rgba(217, 168, 96, 0.7);
  }
  .times {
    display: flex;
    justify-content: space-between;
    margin-top: 0.22rem;
    font-size: 0.6rem;
    color: var(--cream-soft);
    font-variant-numeric: tabular-nums;
  }

  .controls {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .ctl {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    color: var(--cream);
    opacity: 0.85;
    transition: opacity 180ms ease, background 180ms ease, transform 180ms ease;
  }
  .ctl svg { width: 15px; height: 15px; }
  .ctl:hover { opacity: 1; background: rgba(246, 234, 211, 0.12); }
  .ctl:active { transform: scale(0.96); }
  .ctl-play {
    width: 38px;
    height: 38px;
    background: rgba(246, 234, 211, 0.9);
    color: var(--maroon-deep);
    opacity: 1;
    position: relative;
  }
  .ctl-play svg { width: 17px; height: 17px; }
  .ctl-play:hover { background: var(--cream); }
  .ctl-play .icon.is-hidden { display: none; }

  /* Keep the same single-row "art | meta | controls" layout as desktop
     on mobile too, just scaled down further -- stacking the controls
     onto their own row (the old approach) roughly doubled the player's
     height and ate too much of the artwork. The track title still
     wraps to 2 lines instead of truncating, so a narrower row is safe. */
  @media (max-width: 640px) {
    .topbar { padding: 0.9rem 1rem; }
    .links { gap: 0.7rem; }
    .player {
      width: calc(100% - 1.6rem);
      padding: 0.45rem 0.6rem;
      bottom: 0.6rem;
      border-radius: 10px;
    }
    .player .row {
      grid-template-columns: 38px 1fr auto;
      grid-template-areas: "art meta controls";
      column-gap: 0.5rem;
    }
    .art { width: 38px; height: 38px; border-radius: 5px; }
    .track { font-size: 0.82rem; line-height: 1.18; }
    .artist { font-size: 0.62rem; }
    .progress { margin-top: 0.2rem; }
    .times { font-size: 0.54rem; margin-top: 0.15rem; }
    .controls { gap: 0.1rem; }
    .ctl { width: 28px; height: 28px; }
    .ctl svg { width: 12px; height: 12px; }
    .ctl-play { width: 32px; height: 32px; }
    .ctl-play svg { width: 14px; height: 14px; }
  }

  @media (max-width: 400px) {
    .playlist-link span:not(.arrow) { display: none; }
    .playlist-link .arrow { display: none; }
  }
</style>
