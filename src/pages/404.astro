---
import Layout from '~/layouts/Layout.astro';
import hero from '~/assets/hero.webp';
import heroJpg from '~/assets/hero.jpg';
import heroMobile from '~/assets/hero-mobile.webp';
import heroMobileJpg from '~/assets/hero-mobile.jpg';
---
<Layout title="Not found — Khoobsurati" description="This chair’s empty. Head back to the parlour.">
  <main class="stage">
    <picture class="bg">
      <source srcset={heroMobile.src} type="image/webp" media="(max-width: 760px)" />
      <source srcset={heroMobileJpg.src} type="image/jpeg" media="(max-width: 760px)" />
      <source srcset={hero.src} type="image/webp" />
      <img
        src={heroJpg.src}
        width={hero.width}
        height={hero.height}
        alt=""
        loading="eager"
        decoding="async"
        class="bg-img"
      />
    </picture>

    <div class="veil" aria-hidden="true"></div>

    <section class="panel" role="alert">
      <div class="code">404</div>
      <h1 class="line1">यह कुर्सी खाली है</h1>
      <p class="line2">This chair’s empty. The stylist is on chai break.</p>
      <a class="back" href="/">← back to the parlour</a>
    </section>
  </main>
</Layout>

<style>
  .stage {
    position: relative;
    width: 100vw;
    min-height: 100svh;
    min-height: 100vh;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    place-items: center;
  }
  .bg { position: absolute; inset: 0; z-index: 0; }
  .bg-img,
  .bg :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% center;
  }
  @media (max-width: 760px) {
    .bg-img,
    .bg :global(img) { object-position: center; }
  }
  .veil {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(20, 10, 8, 0.55) 0%,
      rgba(20, 10, 8, 0.35) 50%,
      rgba(20, 10, 8, 0.6) 100%
    );
  }
  .panel {
    position: relative;
    z-index: 2;
    max-width: 32rem;
    padding: 1.6rem 1.8rem;
    background: linear-gradient(180deg, rgba(58, 15, 17, 0.72), rgba(42, 10, 12, 0.78));
    border: 1px solid rgba(217, 168, 96, 0.28);
    border-radius: 14px;
    backdrop-filter: blur(14px) saturate(120%);
    -webkit-backdrop-filter: blur(14px) saturate(120%);
    color: var(--cream);
    text-align: center;
    box-shadow: var(--shadow);
    margin: 1rem;
  }
  .code {
    font-family: var(--font-serif);
    font-size: 3.6rem;
    line-height: 1;
    color: var(--gold);
    letter-spacing: 0.04em;
  }
  .line1 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.35rem;
    margin: 0.6rem 0 0.25rem;
    color: var(--cream);
  }
  .line2 {
    margin: 0 0 1rem;
    font-size: 0.95rem;
    color: var(--cream-dim);
  }
  .back {
    display: inline-block;
    padding: 0.55rem 1rem;
    border: 1px solid rgba(246, 234, 211, 0.35);
    border-radius: 999px;
    font-size: 0.85rem;
    transition: background 180ms ease, border-color 180ms ease;
  }
  .back:hover {
    background: rgba(246, 234, 211, 0.1);
    border-color: rgba(246, 234, 211, 0.55);
  }
</style>
